---
import { MUNICIPALITIES } from "@/lib/config/municipal";
type Props = { initialMunicipality?: string };
const { initialMunicipality = "" } = Astro.props;
---
<municipal-weather class="weather-section" data-initial-municipality={initialMunicipality}>
  <section aria-labelledby="weather-title">
    <div class="weather-heading">
      <div><p class="weather-eyebrow">PARA ORGANIZAR TU DÍA</p><h2 id="weather-title">El tiempo en tu municipio</h2><p class="weather-subtitle">Hoy y los próximos seis días</p></div>
      <label class="weather-selector">Consultar municipio<select data-weather-municipality aria-label="Municipio del pronóstico">{MUNICIPALITIES.map((item) => <option value={item.slug} selected={(initialMunicipality || "monterrey") === item.slug}>{item.name}</option>)}</select></label>
    </div>
    <p class="weather-status" data-weather-status role="status" aria-live="polite">Cargando el pronóstico…</p>
    <button class="weather-retry" data-weather-retry type="button" hidden>Volver a intentar</button>
    <div data-weather-body hidden>
      <div class="weather-now">
        <div><p class="weather-kicker" data-weather-location></p><div class="weather-temperature"><span data-weather-icon aria-hidden="true"></span><strong data-weather-temperature></strong><span class="weather-units">°C</span></div><p class="weather-condition" data-weather-condition></p></div>
        <div class="weather-now-details"><p data-weather-range></p><p data-weather-rain></p><p data-weather-wind></p><p class="weather-estimate" data-weather-estimate></p></div>
      </div>
      <div class="weather-week-scroll" tabindex="0" role="region" aria-label="Pronóstico de siete días; desplaza para ver todos los días"><ol class="weather-week" data-weather-days></ol></div>
      <p class="weather-updated" data-weather-updated></p>
    </div>
    <p class="weather-note">Referencia: cabecera municipal. Puede variar entre colonias y zonas de montaña. Hoy cubre las horas disponibles; los días siguientes son estimaciones que pueden cambiar. La lluvia se expresa en milímetros, no como certeza.</p>
    <p class="weather-source">Datos de <a href="https://www.met.no/en" target="_blank" rel="noopener noreferrer">MET Norway</a>, instituto meteorológico de Noruega · <a data-weather-source href="https://api.met.no/weatherapi/locationforecast/2.0/documentation" target="_blank" rel="noopener noreferrer">Fuente</a> · <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>. Resumen diario y traducción de Periódico Rojo. <a href="https://smn.conagua.gob.mx/es/" target="_blank" rel="noopener noreferrer">Consulta avisos del SMN</a>.</p>
    <noscript><p class="weather-note">Activa JavaScript para consultar el pronóstico actualizado o visita el Servicio Meteorológico Nacional.</p></noscript>
  </section>
</municipal-weather>

<script>
  import { isWeatherMunicipality, localDay, WEATHER_LOCATIONS, WEATHER_TIMEZONE, type MunicipalForecast, type WeatherDay } from "@/lib/weather/forecast";
  class MunicipalWeather extends HTMLElement {
    private select!: HTMLSelectElement;
    private controller?: AbortController;
    private timer?: ReturnType<typeof setInterval>;
    private observer?: IntersectionObserver;
    private visible = false;
    private lastLoaded = 0;
    private selected = "";
    private change = () => { this.selected = this.select.value; void this.load(); };
    private retry = () => void this.load();
    private editionChange = (event: Event) => {
      const municipality = (event as CustomEvent<string>).detail;
      if (isWeatherMunicipality(municipality) && municipality !== this.selected) { this.select.value = municipality; this.change(); }
    };
    private refresh = () => { if (!document.hidden && this.visible && Date.now() - this.lastLoaded > 30 * 60_000) void this.load(); };
    connectedCallback() {
      this.select = this.querySelector<HTMLSelectElement>("[data-weather-municipality]")!;
      const fromUrl = new URL(window.location.href).searchParams.get("municipio");
      const initial = fromUrl ?? this.dataset.initialMunicipality ?? "";
      this.selected = isWeatherMunicipality(initial) ? initial : "monterrey";
      this.select.value = this.selected;
      this.select.addEventListener("change", this.change);
      this.querySelector("[data-weather-retry]")?.addEventListener("click", this.retry);
      this.closest("municipal-news")?.addEventListener("municipality-change", this.editionChange);
      document.addEventListener("visibilitychange", this.refresh);
      this.observer = new IntersectionObserver((entries) => { this.visible = entries.some((entry) => entry.isIntersecting); this.refresh(); }, { rootMargin: "200px" });
      this.observer.observe(this);
      this.timer = setInterval(this.refresh, 60_000);
    }
    disconnectedCallback() {
      this.controller?.abort();
      this.observer?.disconnect();
      clearInterval(this.timer);
      this.select.removeEventListener("change", this.change);
      this.querySelector("[data-weather-retry]")?.removeEventListener("click", this.retry);
      this.closest("municipal-news")?.removeEventListener("municipality-change", this.editionChange);
      document.removeEventListener("visibilitychange", this.refresh);
    }
    private put(selector: string, text: string) { this.querySelector<HTMLElement>(selector)!.textContent = text; }
    private number(value: number) { return new Intl.NumberFormat("es-MX", { maximumFractionDigits: 1 }).format(value); }
    private rain(day: WeatherDay) { return day.precipitation === null ? "Lluvia: dato incompleto" : day.precipitation === 0 ? "Sin lluvia prevista" : `${this.number(day.precipitation)} mm de lluvia prevista`; }
    private async load() {
      const municipality = this.selected;
      this.controller?.abort();
      const controller = new AbortController();
      this.controller = controller;
      this.lastLoaded = Date.now();
      this.querySelector<HTMLElement>("[data-weather-body]")!.hidden = true;
      this.querySelector<HTMLElement>("[data-weather-retry]")!.hidden = true;
      this.setAttribute("aria-busy", "true");
      this.put("[data-weather-status]", `Consultando el pronóstico de ${this.select.selectedOptions[0].text}…`);
      try {
        const response = await fetch(`/api/clima?municipio=${encodeURIComponent(municipality)}`, { signal: controller.signal });
        if (!response.ok) throw new Error("Forecast unavailable");
        const forecast: MunicipalForecast = await response.json();
        if (controller.signal.aborted || this.selected !== municipality) return;
        if (forecast.municipality !== municipality || forecast.days?.length !== 7 || forecast.days[0].date !== localDay(new Date()) || Date.now() - Date.parse(forecast.updatedAt) > 12 * 60 * 60_000) throw new Error("Outdated forecast");
        this.render(forecast);
        this.put("[data-weather-status]", `Pronóstico de ${forecast.name} disponible.`);
        this.querySelector<HTMLElement>("[data-weather-body]")!.hidden = false;
      } catch {
        if (controller.signal.aborted) return;
        this.put("[data-weather-status]", "No pudimos obtener un pronóstico actualizado. Intenta de nuevo más tarde o consulta el SMN en el enlace de abajo.");
        this.querySelector<HTMLElement>("[data-weather-retry]")!.hidden = false;
      } finally { if (this.controller === controller) this.setAttribute("aria-busy", "false"); }
    }
    private render(forecast: MunicipalForecast) {
      const today = forecast.days[0];
      this.put("[data-weather-location]", `${forecast.name} · hoy`);
      this.put("[data-weather-icon]", forecast.current.condition.icon);
      this.put("[data-weather-temperature]", String(Math.round(forecast.current.temperature)));
      this.put("[data-weather-condition]", forecast.current.condition.label);
      this.put("[data-weather-range]", `Rango previsto: ${this.number(today.minimum)}° a ${this.number(today.maximum)} °C`);
      this.put("[data-weather-rain]", this.rain(today));
      this.put("[data-weather-wind]", forecast.current.wind === null ? "" : `Viento previsto: ${this.number(forecast.current.wind)} km/h`);
      const time = new Intl.DateTimeFormat("es-MX", { timeZone: WEATHER_TIMEZONE, hour: "2-digit", minute: "2-digit" });
      this.put("[data-weather-estimate]", `Temperatura estimada para las ${time.format(new Date(forecast.current.time))}.`);
      const list = this.querySelector<HTMLOListElement>("[data-weather-days]")!;
      const cards = forecast.days.map((day, index) => {
        const card = document.createElement("li");
        const date = document.createElement("time");
        date.dateTime = day.date;
        date.textContent = index === 0 ? "Hoy" : new Intl.DateTimeFormat("es-MX", { weekday: "short", day: "numeric", month: "short", timeZone: "UTC" }).format(new Date(`${day.date}T12:00:00Z`));
        const icon = document.createElement("span"); icon.className = "day-icon"; icon.setAttribute("aria-hidden", "true"); icon.textContent = day.condition.icon;
        const condition = document.createElement("p"); condition.className = "day-condition"; condition.textContent = day.condition.label;
        const temperature = document.createElement("p"); temperature.className = "day-temperatures"; temperature.textContent = `${this.number(day.maximum)}° / ${this.number(day.minimum)}°`;
        const rain = document.createElement("p"); rain.className = "day-rain"; rain.textContent = this.rain(day);
        card.append(date, icon, condition, temperature, rain);
        if (day.partial) { const partial = document.createElement("small"); partial.textContent = index === 0 ? "Horas disponibles" : "Datos parciales"; card.append(partial); }
        return card;
      });
      list.replaceChildren(...cards);
      const updated = new Intl.DateTimeFormat("es-MX", { timeZone: WEATHER_TIMEZONE, dateStyle: "medium", timeStyle: "short" }).format(new Date(forecast.updatedAt));
      this.put("[data-weather-updated]", `Fuente actualizada: ${updated} · hora de Nuevo León. Temperaturas: máxima / mínima de los intervalos disponibles.`);
      const location = WEATHER_LOCATIONS[forecast.municipality];
      this.querySelector<HTMLAnchorElement>("[data-weather-source]")!.href = `https://api.met.no/weatherapi/locationforecast/2.0/compact?lat=${location.latitude}&lon=${location.longitude}`;
    }
  }
  if (!customElements.get("municipal-weather")) customElements.define("municipal-weather", MunicipalWeather);
</script>

<style>
  .weather-section{display:block;padding-top:2.5rem}[hidden]{display:none!important}.weather-heading{display:flex;align-items:end;justify-content:space-between;gap:1.5rem;padding-bottom:1rem;border-bottom:2px solid var(--paper-ink)}.weather-eyebrow{font-size:.6rem;font-weight:700;letter-spacing:.15em;color:var(--paper-red);margin-bottom:.45rem}.weather-heading h2{font-size:1.35rem;font-weight:650;letter-spacing:-.02em}.weather-subtitle{font-size:.75rem;color:var(--paper-muted);margin-top:.35rem}.weather-selector{display:flex;flex-direction:column;gap:.4rem;font-size:.65rem;font-weight:700}.weather-selector select{border:1px solid var(--paper-rule);background:transparent;color:var(--paper-ink);padding:.65rem .75rem;font-size:.8rem;min-width:14rem;max-width:100%}.weather-status{font-size:.75rem;color:var(--paper-muted);padding-block:1rem}.weather-section[aria-busy=false] .weather-status:has(+button[hidden]){position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip-path:inset(50%)}.weather-retry{font-size:.75rem;color:var(--paper-red);text-decoration:underline;cursor:pointer;padding-bottom:1rem}.weather-now{display:flex;align-items:center;gap:3rem;padding:1.75rem 1.5rem;background:#f0ede6;border-bottom:1px solid var(--paper-rule)}.weather-kicker{font-size:.7rem;font-weight:700}.weather-temperature{display:flex;gap:.6rem;align-items:center;margin-block:.45rem}.weather-temperature>span:first-child{font-size:2.3rem;margin-right:.4rem}.weather-temperature strong{font-family:var(--font-serif);font-size:3.7rem;line-height:1;font-weight:500;letter-spacing:-.05em}.weather-units{font-size:1.2rem;align-self:start;margin-top:.5rem}.weather-condition{font-size:.85rem}.weather-now-details{border-left:1px solid var(--paper-rule);padding-left:2rem;font-size:.8rem;line-height:1.9}.weather-estimate{font-size:.65rem;color:var(--paper-muted);margin-top:.3rem}.weather-week-scroll{overflow-x:auto}.weather-week{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));list-style:none;margin:0;padding:0}.weather-week :global(li){display:flex;flex-direction:column;align-items:center;text-align:center;padding:1.25rem .6rem;border-right:1px solid var(--paper-rule);border-bottom:1px solid var(--paper-rule);gap:.45rem;min-width:0}.weather-week :global(li:first-child){border-left:1px solid var(--paper-rule)}.weather-week :global(time){font-size:.65rem;font-weight:700;text-transform:capitalize}.weather-week :global(.day-icon){font-size:1.65rem;line-height:1.3}.weather-week :global(.day-condition){font-size:.65rem;min-height:2.5em;line-height:1.35}.weather-week :global(.day-temperatures){font-size:.8rem;font-weight:700}.weather-week :global(.day-rain){font-size:.6rem;color:var(--paper-muted);line-height:1.5}.weather-week :global(small){font-size:.55rem;color:var(--paper-muted)}.weather-updated,.weather-note,.weather-source{font-size:.65rem;color:var(--paper-muted);line-height:1.7;margin-top:.7rem}.weather-updated{font-weight:600}.weather-source a{text-decoration:underline;text-underline-offset:2px}.weather-source a:hover{color:var(--paper-red)}select:focus-visible,.weather-week-scroll:focus-visible,button:focus-visible{outline:2px solid var(--paper-red);outline-offset:3px}
  @media(max-width:800px){.weather-week{min-width:780px}.weather-now{gap:2rem}.weather-now-details{padding-left:1.5rem}}
  @media(max-width:520px){.weather-heading{align-items:stretch;flex-direction:column;gap:1rem}.weather-selector select{width:100%}.weather-heading h2{font-size:1.2rem}.weather-now{padding:1.25rem 1rem;gap:1.2rem;align-items:start;flex-direction:column}.weather-now-details{border-left:0;border-top:1px solid var(--paper-rule);padding:1rem 0 0;width:100%}.weather-temperature strong{font-size:3.1rem}}
</style>
