---
import { MUNICIPALITIES, NEWS_CATEGORIES } from "@/lib/config/municipal";
---
<footer class="paper-footer" data-pagefind-ignore="all">
  <div class="container footer-grid">
    <div><a href="/" class="footer-brand">PERIÓDICO <span>ROJO</span></a><p>La información cerca de ti.</p><p>Noticias, eventos y avisos de la zona metropolitana de Monterrey. Cada nota incluye su fuente.</p></div>
    <nav aria-label="Municipios en el pie de página"><strong>Municipios</strong>{MUNICIPALITIES.map((item)=><a href={`/municipios/${item.slug}`}>{item.name}</a>)}</nav>
    <nav aria-label="Secciones"><strong>Secciones</strong>{NEWS_CATEGORIES.map((item)=><a href={`/categorias/${item.slug}`}>{item.name}</a>)}</nav>
  </div>
  <div class="container footer-bottom"><span>© {new Date().getFullYear()} Periódico Rojo</span><div><a href="/about">Sobre el periódico</a><a href="/rss.xml">RSS</a></div></div>
</footer>
<style>
.paper-footer{border-top:3px solid var(--paper-ink);background:var(--paper-bg);color:var(--paper-ink);margin-top:4rem;padding-block:2.5rem 1rem}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:3rem}.footer-brand{font-family:var(--font-serif);font-size:1.5rem;font-weight:800;letter-spacing:-.04em}.footer-brand span{color:var(--paper-red)}p{font-size:.8rem;color:var(--paper-muted);max-width:25rem;margin-top:.6rem;line-height:1.7}nav{display:flex;flex-direction:column;gap:.5rem;font-size:.75rem}nav strong{margin-bottom:.5rem;text-transform:uppercase;letter-spacing:.1em;font-size:.65rem}a:hover{text-decoration:underline}.footer-bottom{margin-top:2rem;border-top:1px solid var(--paper-rule);padding-top:1rem;display:flex;justify-content:space-between;font-size:.68rem;color:var(--paper-muted)}.footer-bottom div{display:flex;gap:1rem}@media(max-width:640px){.footer-grid{grid-template-columns:1fr 1fr;gap:2rem}.footer-grid>div{grid-column:1/-1}}
</style>
