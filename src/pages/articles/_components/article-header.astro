---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { municipalityName, categoryName } from "@/lib/config/municipal";
import { authorsHandler } from "@/lib/handlers/authors";
import Share from "@/components/elements/share.astro";
type Props = { article: CollectionEntry<"articles">; readingTime: string };
const { article } = Astro.props;
const data = article.data;
const authors = authorsHandler.getAuthors(data.authors);
const date = (value: string | Date) => new Intl.DateTimeFormat("es-MX", { dateStyle: "long", timeStyle: "short", timeZone: "America/Monterrey" }).format(new Date(value));
const sourceDate = (value: string) => new Intl.DateTimeFormat("es-MX", { dateStyle: "long", timeZone: "UTC" }).format(new Date(value));
---
<section class="container article-heading">
  <a class="back" href={data.municipality ? `/municipios/${data.municipality}` : "/"}>← Volver a noticias</a>
  <div class="tags"><a href={`/municipios/${data.municipality}`}>{municipalityName(data.municipality)}</a><span>·</span><a href={`/categorias/${data.category.id}`}>{categoryName(data.category.id)}</a></div>
  <h1>{data.title}</h1><p class="description">{data.description}</p>
  <p class="byline">{authors.map((author) => author.data.name).join(", ")} · Publicado el <time datetime={new Date(data.publishedTime).toISOString()}>{date(data.publishedTime)}</time></p>
  {data.sourcePublishedDate && <p class="byline">Fecha del comunicado original: <time datetime={data.sourcePublishedDate}>{sourceDate(data.sourcePublishedDate)}</time></p>}
  {data.cover && <figure><Image src={data.cover} alt={data.covert_alt ?? data.title} width={1200} loading="eager" class="article-photo" />{data.photoCredit && <figcaption>Foto: {data.photoCredit}{data.sourceImageUrl && <> · <a href={data.sourceImageUrl} target="_blank" rel="noopener noreferrer">Ver imagen original ↗</a></>}</figcaption>}</figure>}
  {data.eventDate && <aside class="event-info"><strong>{data.eventStatus === "cancelado" ? "Aviso: evento cancelado" : "Datos del evento"}</strong><p>Fecha: <time datetime={data.eventDate}>{date(data.eventDate)}</time></p>{data.eventLocation && <p>Lugar: {data.eventLocation}</p>}{data.eventAdmission && <p>Acceso: {data.eventAdmission}</p>}</aside>}
  {data.sourceUrl && <p class="official-source">Fuente oficial: <a href={data.sourceUrl} target="_blank" rel="noopener noreferrer">{data.sourceName ?? "Publicación original"} ↗</a></p>}
  <Share text={data.title} />
</section>
<style>
.article-heading{max-width:960px;padding-top:2rem;margin-bottom:2rem}.back{font-size:.75rem;color:var(--paper-muted)}.tags{display:flex;gap:.5rem;color:var(--paper-red);font-size:.7rem;font-weight:700;margin-top:2rem}h1{font-family:var(--font-serif);font-size:clamp(2rem,4vw,3rem);font-weight:700;line-height:1.15;letter-spacing:-.03em;margin-top:.8rem}.description{font-size:1.1rem;color:var(--paper-muted);line-height:1.6;margin-top:1rem}.byline{font-size:.7rem;color:var(--paper-muted);line-height:1.8;margin-block:1.5rem}figure{margin-block:1.5rem}.article-photo{width:100%;height:auto}figcaption{font-size:.65rem;color:var(--paper-muted);margin-top:.4rem}.event-info{padding:1.2rem 1.5rem;border-left:3px solid var(--paper-red);background:#f0ede6;margin-block:1.5rem;font-size:.8rem;line-height:1.9}.official-source{font-size:.75rem;border-block:1px solid var(--paper-rule);padding-block:1rem;margin-bottom:1rem}.official-source a{text-decoration:underline;text-underline-offset:3px}
</style>
